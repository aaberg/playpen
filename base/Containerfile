# omp-base — personal base image for AI agent work
# Language-neutral: OS, shell, git, node, and the omp coding agent.
# Rebuild rarely (new tools / Fedora release): make base
ARG FEDORA_VERSION=44
FROM registry.fedoraproject.org/fedora:${FEDORA_VERSION}

# Core toolchain. Order: least- to most-often-changing.
RUN dnf -y install \
      git zsh \
      nodejs npm \
      gcc gcc-c++ make \
      python3 pipx \
      openssl-devel pkgconf-pkg-config \
      procps-ng findutils diffutils \
      podman \
      sqlite \
    && dnf clean all

# Bun, system-wide (script defaults to $HOME/.bun, which would vanish)
RUN curl -fsSL https://bun.com/install | bash \
    && mv /root/.bun/bin/bun /usr/local/bin/bun \
    && mv /root/.bun/bin/bunx /usr/local/bin/bunx \
    && bun --version

# Non-root agent user with its own throwaway home
RUN useradd -m -s /bin/zsh agent

# Oh My Pi, installed for the agent user
RUN npm install -g @oh-my-pi/pi-coding-agent \
    && chown -R agent:agent /home/agent

# Quiet default zshrc (also applied to newly created homes via /etc/skel)
RUN printf '%s\n' \
      '# Minimal agent-home zshrc' \
      'autoload -Uz compinit && compinit' \
      'HISTFILE=~/.zsh_history' \
      'HISTSIZE=10000' \
      'SAVEHIST=10000' \
      'setopt SHARE_HISTORY HIST_IGNORE_DUPS' \
      "alias ls='ls --color=auto'" \
      > /etc/skel/.zshrc \
    && cp /etc/skel/.zshrc /home/agent/.zshrc \
    && chown agent:agent /home/agent/.zshrc

USER agent

# Minimal git identity - override per project or mount your own
RUN git config --global init.defaultBranch main

WORKDIR /workspace
CMD ["/bin/zsh"]
