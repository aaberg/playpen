# playpen-base — personal base image for AI agent work
# Language-neutral: OS, shell, git, node, bun, and the agent user. Harnesses
# (omp, ...) live in thin per-flavor layers the launcher builds on demand.
# Rebuild rarely (new tools / Fedora release): make base
ARG FEDORA_VERSION=44
FROM registry.fedoraproject.org/fedora-minimal:${FEDORA_VERSION}

# Core toolchain. Order: least- to most-often-changing.
# fedora-minimal ships microdnf and little else; bash, curl and shadow-utils
# (useradd) are not part of the default image.
RUN microdnf -y install \
      bash \
      coreutils \
      curl \
      findutils \
      diffutils \
      procps-ng \
      shadow-utils \
      git \
      nodejs npm \
      gcc gcc-c++ make \
      python3 pipx \
      openssl-devel pkgconf-pkg-config \
      podman \
      sqlite \
    && microdnf clean all

# Bun, system-wide (script defaults to $HOME/.bun, which would vanish)
RUN curl -fsSL https://bun.com/install | bash \
    && mv /root/.bun/bin/bun /usr/local/bin/bun \
    && mv /root/.bun/bin/bunx /usr/local/bin/bunx \
    && bun --version

# Non-root agent user with its own throwaway home
RUN useradd -m -s /bin/bash agent

# Minimal agent-home bashrc (also applied to newly created homes via /etc/skel)
RUN printf '%s\n' \
      '# Minimal agent-home bashrc' \
      'HISTFILE=~/.bash_history' \
      'HISTSIZE=10000' \
      'HISTFILESIZE=10000' \
      'HISTCONTROL=ignoredups' \
      'shopt -s histappend checkwinsize' \
      "alias ls='ls --color=auto'" \
      > /etc/skel/.bashrc \
    && cp /etc/skel/.bashrc /home/agent/.bashrc \
    && chown agent:agent /home/agent/.bashrc

USER agent

# Minimal git identity - override per project or mount your own
RUN git config --global init.defaultBranch main

WORKDIR /workspace
CMD ["/bin/bash"]
