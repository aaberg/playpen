#!/usr/bin/env bash
# Launch omp inside the agent container.
# Usage: playpen [--host-engine] [--keys FILE] [--shell] [image] [-- CMD ARGS...]
#   (default image: playpen-base)
#
# The container command defaults to omp; --shell starts a bash instead, and
# everything after `--` becomes the container command (`-- bash`,
# `-- omp --version`). When the command exits the container is removed (--rm).
#
# API keys come from ~/.config/playpen/keys.conf (override with --keys):
# one NAME=value per line; blank lines and #-comments are ignored. A value
# is either a literal or an op:// reference, resolved with the 1Password
# CLI at launch. No keys file means launching without keys; an unresolvable
# reference aborts the launch.
#
# --host-engine (or PLAYPEN_HOST_ENGINE=1) mounts the host container engine
# socket: the container can then drive the host engine (Testcontainers etc.),
# but code inside can create sibling containers and read anything the host
# user can read. Trusted projects only.
#
# Container engine: podman (default) or docker, selected with PLAYPEN_ENGINE
# or auto-detected when podman is absent. Differences handled per engine:
#   podman: --userns=keep-id, rootless socket at /run/user/$UID/podman.sock
#   docker: --user $UID:$GID (no keep-id equivalent), rootless socket at
#           ~/.docker/run/docker.sock, falling back to /var/run/docker.sock
set -euo pipefail

usage() {
  echo 'usage: playpen [--host-engine] [--keys FILE] [--shell] [image] [-- CMD [ARGS...]]'
}

HOST_ENGINE=0
SHELL_MODE=0
KEYS_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/playpen/keys.conf"
KEYS_EXPLICIT=0
IMAGE=
COMMAND=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --host-engine) HOST_ENGINE=1 ;;
    --shell) SHELL_MODE=1 ;;
    --keys)
      [[ $# -ge 2 ]] || { echo "playpen: --keys needs a file argument" >&2; exit 1; }
      KEYS_FILE="$2"; KEYS_EXPLICIT=1; shift
      ;;
    --)
      shift
      [[ $# -ge 1 ]] || { echo "playpen: -- needs a command" >&2; exit 1; }
      COMMAND=("$@")
      break
      ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "playpen: unknown option: $1" >&2; usage >&2; exit 1 ;;
    *)
      [[ -z "$IMAGE" ]] || { echo "playpen: unexpected argument: $1" >&2; usage >&2; exit 1; }
      IMAGE="$1"
      ;;
  esac
  shift
done
IMAGE="${IMAGE:-playpen-base}"
if [[ "$SHELL_MODE" -eq 1 && ${#COMMAND[@]} -gt 0 ]]; then
  echo "playpen: --shell cannot be combined with a command after --" >&2
  exit 1
fi
if [[ ${#COMMAND[@]} -eq 0 ]]; then
  if [[ "$SHELL_MODE" -eq 1 ]]; then
    COMMAND=(/bin/bash)
  else
    COMMAND=(omp)
  fi
fi
if [[ "${PLAYPEN_HOST_ENGINE:-}" =~ ^(1|true|yes)$ ]]; then
  HOST_ENGINE=1
fi

# Engine selection: explicit PLAYPEN_ENGINE, else auto-detect.
ENGINE="${PLAYPEN_ENGINE:-}"
if [[ -z "$ENGINE" ]]; then
  if command -v podman >/dev/null 2>&1; then
    ENGINE=podman
  elif command -v docker >/dev/null 2>&1; then
    ENGINE=docker
  else
    echo "playpen: neither podman nor docker found in PATH" >&2
    exit 1
  fi
elif [[ "$ENGINE" != podman && "$ENGINE" != docker ]]; then
  echo "playpen: unknown engine: $ENGINE (expected podman or docker)" >&2
  exit 1
fi

ENV_ARGS=()
if [[ ! -f "$KEYS_FILE" ]]; then
  if [[ "$KEYS_EXPLICIT" -eq 1 ]]; then
    echo "playpen: keys file not found: $KEYS_FILE" >&2
    exit 1
  fi
  echo "playpen: $KEYS_FILE not found - launching without API keys" >&2
else
  PERMS="$(stat -c '%a' "$KEYS_FILE")"
  if (( 8#$PERMS & 8#077 )); then
    chmod 600 "$KEYS_FILE"
    echo "playpen: $KEYS_FILE was group/other-readable - tightened to 600" >&2
  fi
  TMP_ENV="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/playpen-env.XXXXXX")"
  trap 'rm -f "$TMP_ENV"' EXIT
  chmod 600 "$TMP_ENV"
  while IFS='=' read -r name value || [[ -n "${name:-}" ]]; do
    name="${name//[[:space:]]/}"     # env var names hold no whitespace
    [[ -z "$name" || "$name" == "#"* ]] && continue
    value="${value:-}"               # a final line without newline leaves it unset
    value="${value%$'\r'}"           # tolerate CRLF line endings
    [[ -z "$value" ]] && continue
    if [[ "$value" == op://* ]]; then
      if ! value="$(op read "$value")"; then
        echo "playpen: could not resolve 1Password reference for $name" >&2
        exit 1
      fi
    fi
    printf '%s=%s\n' "$name" "$value" >> "$TMP_ENV"
  done < "$KEYS_FILE"
  if [[ -s "$TMP_ENV" ]]; then
    ENV_ARGS+=(--env-file "$TMP_ENV")
  fi
fi

ENGINE_ARGS=()
if [[ "$HOST_ENGINE" -eq 1 ]]; then
  if [[ "$ENGINE" == podman ]]; then
    HOST_SOCK="/run/user/$(id -u)/podman/podman.sock"
    if [[ ! -S "$HOST_SOCK" ]]; then
      echo "playpen: host podman socket not found - start it with: systemctl --user start podman.socket" >&2
      exit 1
    fi
  else
    HOST_SOCK="$HOME/.docker/run/docker.sock"
    [[ -S "$HOST_SOCK" ]] || HOST_SOCK=/var/run/docker.sock
    if [[ ! -S "$HOST_SOCK" ]]; then
      echo "playpen: host docker socket not found - is the docker daemon running?" >&2
      exit 1
    fi
  fi
  echo "playpen: host engine access enabled - the boundary is your host user" >&2
  ENGINE_ARGS+=(
    -v "$HOST_SOCK:/run/host-engine.sock"
    -e DOCKER_HOST=unix:///run/host-engine.sock
  )
  if [[ "$ENGINE" == podman ]]; then
    ENGINE_ARGS+=(-e CONTAINER_HOST=unix:///run/host-engine.sock)
  fi
fi

# Podman maps the agent to the invoking user via keep-id; docker has no
# equivalent, so run as the invoking UID:GID directly.
USERNS_ARGS=()
if [[ "$ENGINE" == podman ]]; then
  USERNS_ARGS+=(--userns=keep-id)
else
  USERNS_ARGS+=(--user "$(id -u):$(id -g)")
fi

# The cargo volume only exists for images that define /opt/agent-cargo.
CARGO_ARGS=()
if [[ "$IMAGE" == playpen-rust* ]]; then
  CARGO_ARGS+=(-v playpen-cargo:/opt/agent-cargo)
fi

HOME_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/playpen-home"
if [[ ! -d "$HOME_DIR" ]]; then
  mkdir -p "$HOME_DIR"
  echo "playpen: created $HOME_DIR" >&2
fi

"$ENGINE" run --rm -it \
  "${USERNS_ARGS[@]}" \
  --name "playpen-agent-$$" \
  -v "$PWD":/workspace:Z \
  -v "$HOME_DIR":/home/agent:Z \
  "${CARGO_ARGS[@]}" \
  "${ENGINE_ARGS[@]}" \
  "${ENV_ARGS[@]}" \
  "$IMAGE" \
  "${COMMAND[@]}"
